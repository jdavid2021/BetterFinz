ENVIRONMENT=development
POSTGRES_DB=betterfinz
POSTGRES_USER=betterfinz
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://betterfinz:change-me@postgres:5432/betterfinz
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-with-at-least-32-random-characters
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
TRUSTED_HOSTS=localhost,127.0.0.1,backend

# Observability. Use separate DSNs for the API and web application.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# Required in staging/production when metrics are enabled (32+ random characters).
METRICS_ENABLED=true
METRICS_AUTH_TOKEN=
LOG_LEVEL=INFO
HEALTHCHECK_TIMEOUT_SECONDS=2
SCHEDULER_HEARTBEAT_SECONDS=30
SCHEDULER_STALE_SECONDS=120
# CI-only source-map upload credentials; never expose this token to the browser.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

SIMPLEFIN_ENCRYPTION_KEY=
SIMPLEFIN_ALLOWED_HOSTS=bridge.simplefin.org,beta-bridge.simplefin.org
SIMPLEFIN_SYNC_INTERVAL_MINUTES=360
SIMPLEFIN_SYNC_SCAN_SECONDS=60
SIMPLEFIN_SYNC_LOCK_SECONDS=300
SIMPLEFIN_SYNC_STALE_HOURS=12
SIMPLEFIN_SYNC_RETRY_BASE_MINUTES=5
OPENAI_API_KEY=
OPENAI_TRANSACTION_MODEL=gpt-5.6-luna
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT=10
UPLOAD_RATE_WINDOW_SECONDS=3600
PRIVACY_RATE_LIMIT=3
PRIVACY_RATE_WINDOW_SECONDS=3600

# Legal templates are launch defaults only; have qualified counsel review them.
LEGAL_OPERATOR_NAME=FinLeash
LEGAL_CONTACT_EMAIL=privacy@example.com
LEGAL_GOVERNING_LAW=the laws of the operator's registered jurisdiction
LEGAL_EFFECTIVE_DATE=2026-08-23
LEGAL_TERMS_VERSION=2026-08-23
LEGAL_PRIVACY_VERSION=2026-08-23
LEGAL_RETENTION_DAYS=30
DELETION_GRACE_DAYS=30
DELETION_SCAN_SECONDS=3600

# Social login (Google OAuth). Register at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {PUBLIC_API_URL}/api/v1/auth/google/callback
PUBLIC_API_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Authentication email delivery (Brevo/Resend/SES SMTP). Required outside development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=FinLeash <no-reply@finleash.local>
MAGIC_LINK_TTL_MINUTES=15
EMAIL_VERIFICATION_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=30

# Passkeys (WebAuthn). RP ID must match the domain the frontend is served from.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=FinLeash
